DATABASE_URL="postgresql://plastimatic:plastimatic@localhost:5433/plastimatic?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"
PORT=3001
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# Base URL the API is reachable at from a browser — used to build absolute
# URLs for uploaded files (relative URLs would resolve against the
# frontend's own origin, which is wrong since it runs on a different port).
PUBLIC_API_URL="http://localhost:3001"
# Base URL of the shop frontend — used to build the Stripe Checkout Session's
# success/cancel redirect URLs.
SHOP_URL="http://localhost:5174"
# Stripe test-mode keys (dashboard.stripe.com/test/apikeys). The webhook
# secret comes from `stripe listen --forward-to localhost:3001/api/orders/webhook/stripe`
# for local dev (it prints a `whsec_...` value each time you start it), or
# from a configured webhook endpoint's signing secret in production.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
